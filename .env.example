# ─── Backend API ────────────────────────────────────────────────────────────
# URL du backend Django (préfixe /api/v1 inclus)
NUXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ─── Documentation ──────────────────────────────────────────────────────────
# URL du site docs séparé (projet docs-vizehome)
NUXT_PUBLIC_DOCS_URL=http://localhost:3001

# ─── OAuth ──────────────────────────────────────────────────────────────────
# Client ID public Google (Google Sign-In côté browser)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# Client ID public GitHub (le secret reste côté backend)
NUXT_PUBLIC_GITHUB_CLIENT_ID=

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Sentry browser (error tracking client-side) ────────────────────────────
# DSN public obtenu depuis https://sentry.io/ (projet "vizhome-frontend").
# Laisser vide en dev local pour désactiver Sentry totalement.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development

