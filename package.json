    "@tiptap/extension-placeholder": "^3.24.0",
    "@tiptap/extension-text-align": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@tiptap/vue-3": "^3.24.0",
    "@unovis/ts": "^1.6.5",
    "@unovis/vue": "^1.6.5",
    "@vee-validate/zod": "^4.15.1",
    "embla-carousel-vue": "^8.6.0",
    "eslint": "^10.0.3",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.15.0",
    "lowlight": "^3.3.0",
    "motion-v": "^2.0.0",
    "nuxt": "^4.3.1",
    "reka-ui": "^2.9.9",
    "shadcn-nuxt": "^2.4.3",
