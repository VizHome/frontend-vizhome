    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "lucide-vue-next": "^0.577.0",
    "prettier": "^3.8.1",
    "shadcn-vue": "^2.7.3",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
